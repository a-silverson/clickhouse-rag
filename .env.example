HTTP_ADDR=:8080

CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_DATABASE=rag
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Leave both empty to use CLICKHOUSE_USER for local development.
# Set both to separate mcp_reader (SELECT) and mcp_writer (INSERT, no DELETE).
MCP_READER_USER=
MCP_READER_PASSWORD=
MCP_WRITER_USER=
MCP_WRITER_PASSWORD=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=llama3.2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

EXTRACTION_TABLES=microservice,api,pulsar_topic
EXTRACTION_MIN_CONFIDENCE=0.8
EXTRACTION_CHUNKS_PER_TABLE=3
CHUNK_RUNES=800
CHUNK_OVERLAP=100
AUTO_MIGRATE=true
